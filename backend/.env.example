# Copy to .env and fill in real values. Never commit the filled-in .env.

# Server
PORT=
NODE_ENV=

# Database
MONGODB_URI=

# Auth
JWT_SECRET=

# Bootstrap admin account
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary (media storage)
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=

# Razorpay (payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CURRENCY=

# Email (Nodemailer via Gmail) — EMAIL_PASS must be a Gmail App Password,
# not the account password.
EMAIL_USER=
EMAIL_PASS=

# Base URL of the patient-facing frontend (used for QR verification links)
FRONTEND_URL=

# Comma-separated list of allowed frontend/admin origins, e.g.
# https://app.example.com,https://admin.example.com
# Leave unset only in local development.
CORS_ORIGIN=

# Security toggles
EMAIL_VERIFICATION_REQUIRED=
COOKIE_SECURE=
COOKIE_SAME_SITE=
DISABLE_RATE_LIMITING=
