# Copy to .env and fill in real values. Never commit the filled-in .env.
#
# Load order (first value wins — see config/loadEnv.js):
#   1. real environment variables (Render dashboard / shell)
#   2. backend/.env.local   — per-machine overrides, gitignored
#   3. backend/.env
#
# LOCAL DEVELOPMENT: put only local values in backend/.env.local, e.g.
#   MONGODB_URI=mongodb://127.0.0.1:27017/curalink_dev
# A non-production process refuses to connect to a remote MongoDB unless
# ALLOW_REMOTE_DB=true (see config/dbSafety.js), so local runs can never
# write to the production database by accident.
#
# PRODUCTION: set every value in the Render dashboard (render.yaml lists
# them). NODE_ENV must be "production" there.

# Server
PORT=
NODE_ENV=

# Database
MONGODB_URI=
# Optional, non-production only: set to "true" to deliberately use a remote
# (e.g. staging) database from a local process.
ALLOW_REMOTE_DB=
# Optional, non-production only: comma-separated DNS servers for resolving
# mongodb+srv:// records when the local resolver can't (e.g. 1.1.1.1).
MONGODB_DNS_SERVERS=

# Auth
JWT_SECRET=

# Bootstrap admin account
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary (media storage)
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=

# Razorpay (payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CURRENCY=

# Email (Nodemailer via Gmail) — EMAIL_PASS must be a Gmail App Password,
# not the account password.
EMAIL_USER=
EMAIL_PASS=

# Base URL of the patient-facing frontend (used for QR verification links)
FRONTEND_URL=

# Comma-separated list of allowed frontend/admin origins, e.g.
# https://app.example.com,https://admin.example.com
# Leave unset only in local development.
CORS_ORIGIN=

# Security toggles
EMAIL_VERIFICATION_REQUIRED=
COOKIE_SECURE=
COOKIE_SAME_SITE=
DISABLE_RATE_LIMITING=
