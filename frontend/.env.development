# Local development defaults (committed, no secrets). Vite loads this file for
# `npm run dev` with higher priority than .env, so a dev server always talks to
# the local backend. Production builds (`npm run build`) never read this file —
# they use the hosting platform's build environment (see render.yaml).
# Per-machine overrides go in .env.development.local (gitignored).
VITE_BACKEND_URL=http://localhost:4000
