# Copy to .env and fill in real values. Never commit the filled-in .env.
# All VITE_ vars are inlined into the built bundle at build time — set
# these in the hosting platform's build environment before running
# `npm run build`, not just at runtime.

# Base URL of the backend API
VITE_BACKEND_URL=

# Public Razorpay key used by the checkout widget (safe to expose client-side)
VITE_RAZORPAY_KEY_ID=
